# API キー（必須）。生成例: openssl rand -hex 32
APP_API_KEY=

# Cloudflare Tunnel のトークン（Zero Trust ダッシュボードでトンネル作成時に発行）
TUNNEL_TOKEN=

# ホスト側のセッションログの場所（docker-compose が read-only でマウントする）
CLAUDE_LOG_DIR=~/.claude/projects
CODEX_LOG_DIR=~/.codex/sessions
PI_LOG_DIR=~/.pi/agent/sessions

# ホスト上でセッションログを読むユーザーの UID/GID（id -u / id -g）
APP_UID=10001
APP_GID=10001

# 収集する agent とコンテナ内ログマウント先の対応（収集しない agent は省略）
LOG_DIRS=claude-code=/logs/claude,codex=/logs/codex,pi=/logs/pi

# ログ走査の間隔（秒）
COLLECT_INTERVAL_SEC=300

# 公開パスのプレフィックス。パス配下で公開する場合のみ設定する
# （例: https://ai.nekono.dev/usage/ なら /usage）。
# サブドメインのルートで公開する場合は空のまま。
# 未設定でもアプリがリクエストパスから自動検出するが、確実に動かすなら設定する
APP_BASE_PATH=

# コレクタが登録するレコードの課金種別: subscription / api / unknown
# これらの CLI をサブスクリプション契約で使う場合は subscription（既定）。
# サブスク利用は API 課金ではないため、コストは API リスト価格での換算参考値として扱われる
COLLECTOR_BILLING=subscription

# updater サイドカーのドライラン。通常は空（無効）。
# 1 にすると更新リクエストを受けても git / docker を実行せず、成功扱いで状態だけ進める
UPDATER_DRY_RUN=

# アプリのバージョンビルド時に埋め込む git コミット。通常は空でよい
# （updater が自動で埋める。手動で docker compose build する場合のみ任意指定）
GIT_COMMIT=
